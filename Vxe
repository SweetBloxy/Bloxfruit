--// Status messages
local Messages = {
    "Initializing Vxeze...",
    "Preparing interface...",
    "Connecting components...",
    "Optimizing experience...",
    "Loading visual elements...",
    "Almost everything is ready...",
    "Finalizing preparations...",
    "Taking a little longer...",
    "Preparing final elements...",
    "Almost loaded..."
}

local MessageRunning = true

task.spawn(function()
    while MessageRunning do
        task.wait(math.random(10,20))

        local Message = Messages[math.random(1,#Messages)]

        TweenService:Create(Status,TweenInfo.new(0.6),{
            TextTransparency = 1
        }):Play()

        task.wait(0.6)

        Status.Text = Message

        TweenService:Create(Status,TweenInfo.new(0.8),{
            TextTransparency = 0
        }):Play()
    end
end)

--// Slow progress
for i = 0,99 do
    Percent.Text = i .. "%"

    TweenService:Create(Bar,TweenInfo.new(2,Enum.EasingStyle.Linear),{
        Size = UDim2.new(i/100,0,1,0)
    }):Play()

    task.wait(2)
end

--// 99% hold
Percent.Text = "99%"
